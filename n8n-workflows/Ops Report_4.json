    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n    f.flight_number,\n    f.origin || ' → ' || f.destination AS route,\n    f.departure_ts::date AS flight_date,\n    SUM(sc.total_seats)                      AS total_seats,\n    SUM(sc.total_seats - sc.available_seats) AS booked_seats,\n    ROUND(100.0 * SUM(sc.total_seats - sc.available_seats)\n          / NULLIF(SUM(sc.total_seats),0), 1) AS load_factor_pct,\n    SUM((sc.total_seats - sc.available_seats) * sc.base_price) AS est_revenue\nFROM flights f\nJOIN seat_classes sc ON sc.flight_id = f.id\nWHERE f.status = 'scheduled'\nGROUP BY f.id, f.flight_number, f.origin, f.destination, f.departure_ts\nORDER BY f.departure_ts;",
        "options": {}
      },
