      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n    r.id AS refund_id,\n    r.booking_id,\n    r.amount,\n    r.status,\n    r.created_at,\n    r.escalated\nFROM refunds r\nWHERE r.status = 'pending'\n  AND r.escalated = false\n  AND r.created_at < NOW() - INTERVAL '1 day'\nORDER BY r.created_at ASC;",
        "options": {}
      },
