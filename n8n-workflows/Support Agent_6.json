    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n    sq.id          AS query_id,\n    sq.question,\n    sq.passenger_email,\n    b.id           AS booking_id,\n    b.fare,\n    b.seat_class,\n    b.status       AS booking_status,\n    b.price_paid,\n    b.currency,\n    p.full_name,\n    f.flight_number,\n    f.origin, f.destination,\n    f.departure_ts\nFROM support_queries sq\nJOIN bookings b   ON b.id = sq.booking_id\nJOIN passengers p ON p.id = b.passenger_id\nJOIN flights f    ON f.id = b.flight_id\nWHERE sq.draft_answer IS NULL;",
        "options": {}
