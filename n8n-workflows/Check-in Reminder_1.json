      "id": "c8dfbecc-fe98-45b1-8fc9-65b307c40c38",
      "name": "When clicking ‘Execute workflow’"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n    b.id            AS booking_id,\n    p.full_name,\n    p.email,\n    b.seat_class,\n    f.flight_number,\n    f.origin,\n    f.destination,\n    f.departure_ts,\n    f.origin_tz,\n    to_char(f.departure_ts AT TIME ZONE f.origin_tz, 'DD Mon YYYY, HH12:MI AM') AS local_departure\nFROM bookings b\nJOIN passengers p ON p.id = b.passenger_id\nJOIN flights f    ON f.id = b.flight_id\nWHERE b.status = 'confirmed'\n  AND b.reminder_sent = false\n  AND f.status = 'scheduled'\n  AND f.departure_ts BETWEEN now() AND now() + interval '30 hours';",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        -176,
        -160
      ],
      "id": "8249e52c-aa8c-4115-bec8-0635e26823f1",
      "name": "Execute a SQL query",
      "credentials": {
        "postgres": {
          "id": "znvHCiUsbyW5FYu1",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "sendTo": "={{ $json.email }}",
        "subject": "=Check-in Reminder — Flight {{ $json.flight_number }} to {{ $json.destination }}",
        "emailType": "text",
        "message": "=Dear {{ $json.full_name }},\n\nThis is a reminder that check-in is now open for your flight.\n\nFlight: {{ $json.flight_number }} ({{ $json.origin }} → {{ $json.destination }})\nDeparture (local time): {{ $json.local_departure }}\nClass: {{ $json.seat_class }}\n\nPlease complete check-in before arriving at the airport.\n\nSafe travels!\nFlight Management Team",
        "options": {}
      },
