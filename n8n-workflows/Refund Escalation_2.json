      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n    r.id     AS refund_id,\n    r.booking_id,\n    r.amount,\n    r.created_at,\n    EXTRACT(DAY FROM now() - r.created_at) AS days_pending,\n    p.full_name,\n    p.email\nFROM refunds r\nJOIN bookings b   ON b.id = r.booking_id\nJOIN passengers p ON p.id = b.passenger_id\nWHERE r.status = 'pending'\n  AND r.created_at < now() - interval '5 days'\n  AND r.escalated_at IS NULL;",
        "options": {}
      },
